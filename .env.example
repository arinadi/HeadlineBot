# ============================================================
# HeadlineBot Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# For Kaggle/Colab: use Infisical (recommended) or set these directly.

# --- Infisical (Recommended) ---
# Store secrets in Infisical Cloud, then set these two variables.
# All actual secrets (below) will be fetched from Infisical at runtime.
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_ENV=dev
INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret

# --- Direct Secrets (Legacy / Local Only) ---
# If not using Infisical, set these directly.
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id
# GEMINI_API_KEY=your-gemini-api-key
# GITHUB_TOKEN=your-github-token
# HF_TOKEN=your-huggingface-token

# --- Bot Configuration ---
# HEADLINEBOT_VERSION=prod
# MODEL_SIZE=large-v2
# USE_FP16=auto
# BEAM_SIZE=10
# WHISPER_PATIENCE=2.0
# WHISPER_TEMPERATURE=0.0
# REPETITION_PENALTY=1.1
# NO_REPEAT_NGRAM_SIZE=3
# VAD_FILTER=False
# BOT_FILESIZE_LIMIT=20
# ENABLE_IDLE_MONITOR=True
# IDLE_SHUTDOWN_MINUTES=10
# ENABLE_GEMINI_FEATURES=false
# GEMMA_MODEL=models/gemma-4-26b-a4b-it
# JPEG_QUALITY=95
