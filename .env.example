# HeadlineBot secrets — copy to .env and fill in. Never commit .env.
# VPS / colab CLI: this file is used directly.
# Colab/Kaggle notebook: store base64 of this file as ONE secret, HEADLINEBOT_ENV (see README).

# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI provider key (summary, retouch, photo) — e.g. OpenCode
OPENAI_COMPAT_API_KEY=

# Optional
GEMINI_API_KEY=
HF_TOKEN=
